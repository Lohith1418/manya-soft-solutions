# For GoDaddy cPanel Webmail:
# SMTP_HOST=mail.manyasoftsolutions.com (or smtpout.secureserver.net)
# SMTP_PORT=465
# SMTP_SECURE=true

# For GoDaddy Microsoft 365 Email:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@manyasoftsolutions.com
SMTP_PASS=your-godaddy-email-password
CONTACT_NOTIFICATION_EMAIL=info@manyasoftsolutions.com
